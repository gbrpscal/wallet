# Somente valores locais de exemplo. Copie para .env para sobrescrever os padrões do compose.yaml.

# UID/GID do host usados pelo container tools, para que os arquivos gerados pertençam ao seu usuário.
HOST_UID=1000
HOST_GID=1000

# Portas publicadas no host
APP_HOST_PORT=8080
KEYCLOAK_HOST_PORT=8180

# PostgreSQL. Os papéis e o banco são criados só na primeira inicialização do
# volume; depois de mudar estes valores, recrie o volume (docker compose down -v).
POSTGRES_PASSWORD=postgres
WALLET_DB=wallet
WALLET_OWNER_PASSWORD=wallet_owner
WALLET_APP_PASSWORD=wallet_app

# Administrador inicial do Keycloak (somente local)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# O LocalStack aceita quaisquer credenciais estáticas
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Aplicação
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=30s
DB_LOCK_TIMEOUT=5s

# Espera por referência (REFUND/ROLLBACK antes da transação referenciada)
REFERENCE_MAX_ATTEMPTS=10
REFERENCE_TTL=10m
REFERENCE_BACKOFF_BASE=1s
REFERENCE_BACKOFF_MAX=60s
