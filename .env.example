# Local example values only. Copy to .env to override the defaults in compose.yaml.

# Host UID/GID used by the tools container, so generated files belong to your user.
HOST_UID=1000
HOST_GID=1000

# Published host ports
APP_HOST_PORT=8080
KEYCLOAK_HOST_PORT=8180

# PostgreSQL
POSTGRES_USER=wallet
POSTGRES_PASSWORD=wallet
POSTGRES_DB=wallet

# Keycloak bootstrap admin (local only)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# LocalStack accepts any static credentials
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Application
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=30s
