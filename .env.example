# Somente valores locais de exemplo. Copie para .env para sobrescrever os padrões do compose.yaml.

# UID/GID do host usados pelo container tools, para que os arquivos gerados pertençam ao seu usuário.
HOST_UID=1000
HOST_GID=1000

# Portas publicadas no host
APP_HOST_PORT=8080
KEYCLOAK_HOST_PORT=8180

# PostgreSQL
POSTGRES_USER=wallet
POSTGRES_PASSWORD=wallet
POSTGRES_DB=wallet

# Administrador inicial do Keycloak (somente local)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# O LocalStack aceita quaisquer credenciais estáticas
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Aplicação
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=30s
